# Server-only existing PayPal SANDBOX credentials. Never commit a real .env file.
# Use either the ID + secret pair below OR an existing sandbox access token.
# These values must be authorized for sandbox draft creation before running the probe.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_ACCESS_TOKEN=

# Optional: only needed for postback verification of a real configured webhook.
# The prototype exposes no public webhook ingress and creates no subscriptions.
PAYPAL_WEBHOOK_ID=

# No AI service key is needed for the local synthetic-data machine learning model.
